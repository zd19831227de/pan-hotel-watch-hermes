APP_NAME=Pan Hotel Watch
ENVIRONMENT=local
PAN_HOTEL_ENFORCE_API_AUTH=true
WATCH_API_SHARED_SECRET=

# SQLite default. MySQL example:
# DATABASE_URL=mysql+aiomysql://user:password@127.0.0.1:3306/pan_hotel_watch?charset=utf8mb4
DATABASE_URL=sqlite+aiosqlite:///./pan_hotel_watch.db
DATABASE_AUTO_CREATE_TABLES=true

# EBK 全局定时推送 scheduler（read-only worker 第 7 个 loop）总开关。
# 默认 false；按设计 §4.3 迁移顺序，确认门店旧 auto_poll 已关闭后再打开。
# EBK_GLOBAL_PUSH_SCHEDULER_ENABLED=false

# Relative values resolve under the repo root (not Chrome/Playwright cwd).
# On a fixed watch host you may set an absolute path instead:
# BROWSER_STATE_DIR=C:\pan-hotel-watch-runtime\browser-state
BROWSER_STATE_DIR=.runtime/browser-state
PLAYWRIGHT_ARTIFACT_DIR=output/playwright
# Runtime cleanup retention (days). Scheduled cleanup + manual API honor these;
# no code edit needed to change retention.
# Browser profile WEB cache only (login state + Chromium models are never cleared).
BROWSER_CACHE_RETENTION_DAYS=60
# Playwright OTA-read screenshots (*.png under PLAYWRIGHT_ARTIFACT_DIR).
PLAYWRIGHT_SCREENSHOT_RETENTION_DAYS=30
# EBK business history (ebk_read_snapshots + ctrip_ebooking_watch_runs) retention days;
# daily scheduled cleanup + History [cleanup now] both delete business history older than this.
EBK_BUSINESS_RETENTION_DAYS=180
# Playwright browser binaries default to %LOCALAPPDATA%\ms-playwright on Windows.
# start-all.ps1 / run-backend.ps1 / run-worker.ps1 reset PLAYWRIGHT_BROWSERS_PATH when
# it points at a Cursor sandbox cache or lacks chrome.exe.

# Optional but recommended on the fixed watch host:
# CTRIP_EBOOKING_PROFILE_DIR=C:\pan-hotel-watch-runtime\ctrip-ebk-profile
CTRIP_EBOOKING_PROFILE_DIR=
CTRIP_EBOOKING_URL=https://ebooking.ctrip.com/login/index
CTRIP_EBOOKING_LOGIN_URL=https://ebooking.ctrip.com/login/index
CTRIP_EBOOKING_HOME_URL=https://ebooking.ctrip.com/home/mainland
CTRIP_EBOOKING_USERNAME=
CTRIP_EBOOKING_PASSWORD=
CTRIP_EBOOKING_AUTO_SUBMIT_LOGIN=false
CTRIP_EBOOKING_DEFAULT_PLATFORM_ACCOUNT_ID=
CTRIP_EBOOKING_DEFAULT_BROWSER_SESSION_ID=
CTRIP_EBOOKING_DEFAULT_DISPLAY_NAME=Ctrip EBK account
CTRIP_EBOOKING_DEFAULT_SESSION_PORT=9221
# 美团/飞猪 EBK 浏览器 CDP 调试端口（评价/退单真实适配器 attach 用）。
MEITUAN_EBOOKING_DEFAULT_SESSION_PORT=9521
FLIGGY_EBOOKING_DEFAULT_SESSION_PORT=9531
CTRIP_PUBLIC_COMPETITOR_LOGIN_URL=https://hotels.ctrip.com/
CTRIP_PUBLIC_COMPETITOR_ENABLE_CDP=false
CTRIP_PUBLIC_COMPETITOR_CDP_URL=http://127.0.0.1:9222
CTRIP_PUBLIC_COMPETITOR_CDP_FALLBACK_ENABLED=true

# OpenAI-compatible LLM runtime config. API key can also be saved from the web console.
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
# Comma-separated exact host allowlist. Empty permits DeepSeek, OpenAI, and
# SiliconFlow provider hosts. Custom OpenAI-compatible relays must be listed
# explicitly and resolve only to public addresses.
LLM_ALLOWED_HOSTS=
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=

# 飞书入口模式：
#   hermes（默认）：飞书对话由 Hermes Gateway 接管，后端不启动 feishu-listener、不调用内置大模型；
#                   后端只通过 /api/v1/feishu/events 处理 Hermes 转发的卡片动作与结构化调价命令。
#   builtin：旧行为，后端 feishu-listener 直接用内置大模型回复 @机器人 自由文本。
FEISHU_AGENT_MODE=hermes

# Optional overrides used by the supervisor Feishu admission API. Empty values
# use the repository manifest and the current user's LOCALAPPDATA\hermes runtime.
PAN_HOTEL_FEISHU_PROFILES_MANIFEST=
PAN_HOTEL_HERMES_BASE_PATH=
PAN_HOTEL_HERMES_PYTHON_EXE=
PAN_HOTEL_HERMES_EXE=
PAN_HOTEL_POWERSHELL_EXE=powershell.exe

FEISHU_APP_ID=
FEISHU_APP_SECRET=
# true 时要求业务群同时存在有效 DB Agent binding 和显式 chat→profile 映射。
FEISHU_STRICT_TENANT_ROUTING=false
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_DEFAULT_ACTOR_ID=operator
FEISHU_WEBHOOK_URL=
FEISHU_DEFAULT_PLATFORM_ACCOUNT_ID=

# Local bootstrap credential for protected configuration and role-management APIs.
# Send it only in the X-Pan-Hotel-API-Key header; never place it in URLs or logs.
PAN_HOTEL_BOOTSTRAP_SUPERVISOR_API_KEY=

# 评价自动回复真实抓取/提交适配器开关（默认关闭；逆向接入并显式开启后才连真实浏览器；
# 关闭时对应平台返回 NotReady，不产生任何请求或假数据）。
REVIEW_CTRIP_REAL_ADAPTER_ENABLED=false
REVIEW_MEITUAN_REAL_ADAPTER_ENABLED=false
REVIEW_FLIGGY_REAL_ADAPTER_ENABLED=false
# 退单抓取真实适配器开关（同上；推送读取时顺带抓退单落库供飞书问答调用）。
REFUND_CTRIP_REAL_ADAPTER_ENABLED=false
REFUND_MEITUAN_REAL_ADAPTER_ENABLED=false
REFUND_FLIGGY_REAL_ADAPTER_ENABLED=false

# 评价自动回复定时调度开关（read_only_scheduler 挂 ReviewFetchScheduler）
REVIEW_SCHEDULER_ENABLED=false
